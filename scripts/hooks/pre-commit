#!/bin/sh
# Pre-commit hook:
#   1. Validates spine manifest (if it exists) to catch spec drift before landing
#   2. Verifies the generated Edge sanitizer copy matches the core source
#      (runs the codegen in --check mode — a pure drift detector that writes
#      nothing and depends on no test runtime)
#
# Install: npm run setup:hooks
#
# Both checks are "drift detectors" — they only fail when the working tree
# disagrees with the source of truth. Together they enforce: spine docs agree
# with the on-disk spec paths, and the generated Edge copy agrees with the
# client core module. No background polling, no stale fixtures — the hook
# fires ONLY when something actually drifted.

# --- 1. Spine manifest validation --------------------------------------
# Only run if specs/_doc_spine.yml exists (optional in repos without a spine)
if [ -f "specs/_doc_spine.yml" ]; then
  # Skip if spine:validate script is not available
  if grep -q '"spine:validate"' package.json 2>/dev/null; then
    echo "🔍 Validating spine manifest..."

    # Run spine validation
    npx tsx scripts/validate-spine-manifest.ts
    result=$?

    if [ $result -ne 0 ]; then
      echo ""
      echo "❌ Spine manifest validation failed!"
      echo "   Fix the errors above, or bypass with: git commit --no-verify"
      echo ""
      exit 1
    fi

    echo "✅ Spine manifest is valid."
  fi
fi

# --- 2. Edge sanitizer sync (TC-313) -----------------------------------
# Only run if the core source exists on disk. We call the codegen in --check
# (verify) mode: it regenerates the Edge copy IN MEMORY from the core source
# and compares against the on-disk file, writing nothing. The hook therefore
# fires ONLY when the committed Edge copy has drifted from the core — a true
# drift safety-net with no dependency on the jest/ts-jest runtime (the prior
# jest invocation was the source of the env noise that forced --no-verify).
#
# The companion jest guard tests/guards/edge-untrusted-json-sync.test.ts
# (TC-313) stays in the suite as a belt-and-suspenders check that runs in CI
# and `npm test`; the hook just needs the fast, env-independent path.
if [ -f "src/analysis/untrusted-json-core.ts" ]; then
  echo "🔍 Checking Edge sanitizer sync (TC-313)..."

  npm run --silent verify:edge
  result=$?

  if [ $result -ne 0 ]; then
    echo ""
    echo "❌ Edge sanitizer out of sync with core source (TC-313 drift)!"
    echo "   Run: npm run sync:edge && git add supabase/functions/_shared/untrusted-json.ts"
    echo "   Then re-commit."
    echo "   Bypass: git commit --no-verify"
    echo ""
    exit 1
  fi

  echo "✅ Edge sanitizer in sync."
fi

exit 0

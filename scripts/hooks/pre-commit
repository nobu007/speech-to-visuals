#!/bin/sh
# Pre-commit hook: validates spine manifest to catch spec drift before landing
# Install: npm run setup:hooks

# Only run if specs/_doc_spine.yml exists
if [ ! -f "specs/_doc_spine.yml" ]; then
  exit 0
fi

# Skip if spine:validate script is not available
if ! grep -q '"spine:validate"' package.json 2>/dev/null; then
  exit 0
fi

echo "🔍 Validating spine manifest..."

# Run spine validation
npx tsx scripts/validate-spine-manifest.ts
result=$?

if [ $result -ne 0 ]; then
  echo ""
  echo "❌ Spine manifest validation failed!"
  echo "   Fix the errors above, or bypass with: git commit --no-verify"
  echo ""
  exit 1
fi

echo "✅ Spine manifest is valid."
exit 0

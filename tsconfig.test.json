{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "module": "ESNext",
    "target": "ES2020",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "types": ["jest", "node"],
    "paths": {
      "@/*": ["./src/*"]
    },
    "baseUrl": ".",
    "noImplicitAny": false,
    "strict": false,
    "strictNullChecks": false
  },
  "include": ["src", "tests", "supabase"]
}
